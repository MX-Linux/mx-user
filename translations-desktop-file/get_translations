#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APPNAME="$(basename "$(dirname "$SCRIPT_DIR")")-desktop"
# Everything below works on paths relative to this directory.
cd "$SCRIPT_DIR" || exit 1

echodo() {
  echo "${@}"
  ${@}
}

# prepare transifex 
if [ ! -s  .tx/config ]; then
   mkdir -p .tx
   cat <<EOF > .tx/config
[main]
host = https://www.transifex.com

[o:anticapitalista:p:antix-development:r:$APPNAME]
file_filter = po/${APPNAME}_<lang>.po
source_file = ${APPNAME}.pot
source_lang = en
type = po
EOF
fi    


# Replace the translations with a fresh pull. The existing ones are moved
# aside first, so languages no longer on Transifex are dropped, and are put
# back if the pull fails.
if ! command -v tx >/dev/null; then
   echo "Error: the Transifex client (tx) is not installed; translations were not updated."
   exit 1
fi
# Only this resource's catalogs are replaced. The backup lives in this
# directory, so moving is a rename on the same filesystem; any failure or
# interruption before the pull succeeds restores it.
mkdir -p po
BACKUP_DIR="$(mktemp -d "$SCRIPT_DIR/.translations-backup.XXXXXX")" || exit 1
PULLING=0
restore_translations() {
   echo "Error: translations were not updated; restoring the previous ones."
   # Live catalogs are partial downloads only once the backup is complete.
   if [ "$PULLING" = 1 ]; then
      find po -maxdepth 1 -type f -name "${APPNAME}_*.po" -delete
   fi
   find "$BACKUP_DIR" -maxdepth 1 -type f -exec mv -t po {} +
   rmdir "$BACKUP_DIR"
}
trap 'exit 1' INT TERM # the EXIT trap restores
trap 'restore_translations' EXIT
find po -maxdepth 1 -type f -name "${APPNAME}_*.po" -exec mv -t "$BACKUP_DIR" {} + || exit 1
PULLING=1
echodo tx pull -r antix-development.$APPNAME --all || exit 1
trap - EXIT INT TERM
rm -rf "$BACKUP_DIR"

